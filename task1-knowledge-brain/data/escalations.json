    "question": "Can we integrate custom Solana cryptocurrency payments?",
    "retrieved_sources": [],
    "confidence": 0.0,
    "reason": "No Solana docs found",
    "status": "resolved",
    "created_at": "2026-10-19T03:35:40.935069+00:00",
